# LLM used by CrewAI's agents and by SummarizerTool.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CREWAI_MODEL=groq/llama-3.3-70b-versatile

# Serper news search.
SERPER_API_KEY=

# Slack incoming webhook for the destination channel.
SLACK_WEBHOOK_URL=
# Set true while developing without a Slack app; messages print to the terminal.
SLACK_DRY_RUN=false

# Set NOTIFICATION_PROVIDER=discord to use Discord instead of Slack.
NOTIFICATION_PROVIDER=slack
DISCORD_WEBHOOK_URL=

# Google Sheets service-account JSON, stored as a single-line JSON value.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=News

# Comma-separated topics and maximum stories per topic.
NEWS_TOPICS=artificial intelligence,technology,finance,crypto
NEWS_LIMIT_PER_TOPIC=5

# Vercel sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
